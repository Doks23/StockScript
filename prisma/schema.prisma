generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("PRISMA_DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(cuid())
  name                    String
  email                   String                   @unique
  passwordHash            String
  role                    UserRole                 @default(TRADER)
  emailVerifiedAt         DateTime?
  approvalStatus          ApprovalStatus           @default(PENDING)
  approvedAt              DateTime?
  approvedBy              String?
  isActive                Boolean                  @default(false)
  portfolioCapital        Float                    @default(100000)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  avatarUrl               String?
  bio                     String?
  competitionsCreated     Competition[]            @relation("CompetitionsCreated")
  competitionParticipants CompetitionParticipant[]
  competitionRequests     CompetitionRequest[]
  verificationTokens      EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  sessions                Session[]
  trades                  Trade[]
  approver                User?                    @relation("UserApprovals", fields: [approvedBy], references: [id])
  approvalsGiven          User[]                   @relation("UserApprovals")
  competitionStats        UserCompetitionStat[]

  @@index([role, approvalStatus, isActive])
}

model Trade {
  id            String        @id @default(cuid())
  userId        String
  competitionId String?
  symbol        String
  segment       TradeSegment
  tradeType     TradeType
  closingPrice  Float?
  stopLoss      Float?
  charges       Float         @default(0)
  capitalUsed   Float         @default(0)
  netPnl        Float         @default(0)
  rowIndex      Int           @default(0)
  status        TradeStatus   @default(OPEN)
  tags          String        @default("")
  notes         String        @default("")
  firstEntryAt  DateTime?
  lockedAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  exitTrigger   String?
  growthAreas   String?
  planFollowed  Boolean?
  proficiency   String?
  setup         String?
  reviewed      Boolean       @default(false)
  competition   Competition?  @relation(fields: [competitionId], references: [id])
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  images        TradeImage[]
  transactions  Transaction[]

  @@index([userId, status, firstEntryAt])
  @@index([userId, createdAt])
  @@index([competitionId, status, firstEntryAt])
  @@index([symbol, userId])
  @@index([status])
  @@index([updatedAt])
}

model Transaction {
  id       String          @id @default(cuid())
  tradeId  String
  type     TransactionType
  price    Float
  quantity Float
  dateTime DateTime
  order    Int             @default(0)
  trade    Trade           @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  // Broker sync provenance. All nullable / defaulted so existing rows are untouched.
  externalTradeId String? // Dhan exchangeTradeId - exchange-unique, used for dedupe
  externalOrderId String? // Dhan orderId, audit trail only
  source          String  @default("MANUAL") // MANUAL | CSV | DHAN_API

  @@index([tradeId, type, dateTime])
  @@index([externalTradeId])
  // Backstop for the sync's duplicate check, which is otherwise a read then a
  // write with nothing in between. dateTime is part of the key because Dhan's
  // exchangeTradeId is only documented as unique per exchange per trading day,
  // not globally - pairing them avoids rejecting a legitimate later fill that
  // happens to reuse an id. Rows with a null externalTradeId are unaffected,
  // since Postgres treats nulls as distinct in a unique index.
  @@unique([externalTradeId, dateTime])
}

model TradeImage {
  id         String   @id @default(cuid())
  tradeId    String
  imageUrl   String
  uploadedAt DateTime @default(now())
  trade      Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([tradeId])
}

model Competition {
  id           String                   @id @default(cuid())
  name         String
  startDate    DateTime
  endDate      DateTime
  visibility   CompetitionVisibility
  createdBy    String
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  creator      User                     @relation("CompetitionsCreated", fields: [createdBy], references: [id], onDelete: Cascade)
  participants CompetitionParticipant[]
  requests     CompetitionRequest[]
  trades       Trade[]
  stats        UserCompetitionStat[]

  @@index([startDate, endDate])
  @@index([createdBy])
  @@index([visibility])
}

model CompetitionParticipant {
  id            String      @id @default(cuid())
  competitionId String
  userId        String
  joinedAt      DateTime    @default(now())
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([competitionId, userId])
  @@index([competitionId])
}

model CompetitionRequest {
  id            String        @id @default(cuid())
  competitionId String
  userId        String
  status        RequestStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  approvedBy    String?
  approvedAt    DateTime?
  competition   Competition   @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([competitionId, userId])
  @@index([competitionId, status])
}

model UserCompetitionStat {
  userId             String
  competitionId      String
  portfolioImpactPct Float       @default(0)
  returnPercentage   Float       @default(0)
  maxDrawdown        Float       @default(0)
  winRate            Float       @default(0)
  totalTrades        Int         @default(0)
  profitFactor       Float       @default(0)
  updatedAt          DateTime    @updatedAt
  competition        Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, competitionId])
  @@index([competitionId, portfolioImpactPct, maxDrawdown, winRate])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  token      String    @unique
  userId     String
  email      String
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, email, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

enum UserRole {
  ADMIN
  TRADER
  SUPER_TRADER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TradeSegment {
  EQUITY
  INTRADAY
  OPTIONS
  FUTURES
}

enum TradeType {
  LONG
  SHORT
}

enum TradeStatus {
  OPEN
  CLOSED
}

enum CompetitionVisibility {
  PUBLIC
  PRIVATE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransactionType {
  BUY
  SELL
}
